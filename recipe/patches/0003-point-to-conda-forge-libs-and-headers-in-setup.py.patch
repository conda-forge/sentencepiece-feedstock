 python/setup.py | 131 +++++++++++++++++++-----------------------------
 1 file changed, 51 insertions(+), 80 deletions(-)

diff --git a/python/setup.py b/python/setup.py
index f1d0b29..14d8785 100755
--- a/python/setup.py
+++ b/python/setup.py
@@ -99,56 +99,41 @@ class build_ext_unix(_build_ext):
   """Override build_extension to run cmake."""
 
   def build_extension(self, ext):
-    cflags, libs = get_cflags_and_libs('../build')
-    abseil_libs = find_abseil_lib('../build')
-
-    if len(libs) == 0:
-      cflags, libs = get_cflags_and_libs('./build')
