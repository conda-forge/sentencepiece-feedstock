-      build_dir = '.\\build'
-    else:
-      # build library locally with cmake and vc++.
-      if arch == 'amd64':
-        cmake_arch = 'x64'
-      elif arch == 'arm64':
-        cmake_arch = 'ARM64'
-      else:
-        raise RuntimeError(f"Unsupported architecture: {arch}")
-
-      cmake_src = 'sentencepiece' if os.path.exists('sentencepiece') else '..'
-      subprocess.check_call([
-          'cmake',
-          cmake_src,
-          '-A',
-          cmake_arch,
-          '-B',
-          'build',
-          '-DSPM_ENABLE_SHARED=OFF',
-          '-DSPM_ENABLE_LITE=OFF',
-          '-DSPM_DISABLE_EMBEDDED_DATA=ON',
-          '-DCMAKE_INSTALL_PREFIX=build\\root',
-      ])
-      subprocess.check_call([
-          'cmake',
-          '--build',
-          'build',
-          '--config',
-          'Release',
-          '--target',
-          'install',
-          '--parallel',
-          '8',
-      ])
-      build_dir = '.\\build'
-
-    cflags = ['/std:c++20'] + get_build_includes(build_dir, is_msvc=True)
+    cflags = [
+        '/std:c++20',
+        '/MD',
+        '/DSPM_DLL_IMPORTS',
+        '/DPROTOBUF_USE_DLLS',
+        '/I' + os.environ['LIBRARY_INC'],
+        '/I..\\src',
+        '/I..\\lite',
+        '/I..',
+    ]
+    # most of abseil can be built as shared, which ends up in one giant library
+    # called abseil_dll; the absl_flags_* libraries always stay static
+    absl_libs = [
+        'abseil_dll',
+        'absl_log_flags',
+        'absl_flags_commandlineflag',
+        'absl_flags_commandlineflag_internal',
+        'absl_flags_config',
+        'absl_flags_internal',
+        'absl_flags_marshalling',
+        'absl_flags_parse',
+        'absl_flags_private_handle_accessor',
+        'absl_flags_program_name',
+        'absl_flags_reflection',
+        'absl_flags_usage',
+        'absl_flags_usage_internal',
+    ]
     libs = [
-        os.path.join(build_dir, 'root', 'lib', 'sentencepiece.lib'),
-        os.path.join(build_dir, 'root', 'lib', 'sentencepiece_train.lib'),
+        os.path.join(os.environ['LIBRARY_LIB'], f'{x}.lib')
+        for x in [
+            'sentencepiece_import',
+            'sentencepiece_train_import',
+            'libprotobuf-lite',
+        ]
+        + absl_libs
     ]
-    libs.extend(find_abseil_lib(build_dir))
 
